# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
# Optional: restrict bot access to your specific Telegram chat ID (integer)
# AUTHORIZED_CHAT_ID=123456789

# AI Motion Generation Flag
# True = Try Stable Video Diffusion (SVD) on GPU first, fallback to Depth Parallax if unavailable
# False = Use Depth-based Parallax directly (CPU-friendly, zero GPU VRAM required)
USE_AI_MOTION=True

# Video Settings
TARGET_WIDTH=1080
TARGET_HEIGHT=1920
FPS=25
REEL_DURATION_SEC=5
